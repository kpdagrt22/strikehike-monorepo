# Used by Docker Compose on the Lightsail host.
# Direct browser CORS origin; the Next server proxy itself is internal.
CORS_ORIGINS=https://strikehike.com,https://www.strikehike.com

# Google Search Console verification token. The deploy workflow passes this to
# the frontend image at build time; the tag is omitted when it is empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Weekly email digest. Keep DIGEST_ENABLED=0 until the owner is ready to show
# the form. RESEND_API_KEY and DIGEST_TOKEN_SECRET are GitHub secrets, never
# values in this file.
DIGEST_ENABLED=0
DIGEST_POSTAL_ADDRESS=
DIGEST_FROM=StrikeHike <digest@strikehike.com>
DIGEST_REPLY_TO=
DIGEST_BASE_URL=https://strikehike.com
