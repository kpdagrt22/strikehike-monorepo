# Backend settings. Every value is optional; the defaults are shown.
# The API does not read this file on its own: copy it to .env and start it with
#   uvicorn api_server:app --env-file .env
# The ingestion flow reads FRED_API_KEY from backend/.env (or a repository-root .env) itself.
# Docker Compose sets the deployed stack's values in ../docker-compose.yml.

# Comma-separated browser origins allowed by CORS. No spaces.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 1 loads the earlier HMM and XGBoost joblib files at startup. No endpoint uses them.
LOAD_ML_MODELS=0

# 1 mounts the simulated Socket.IO feed from websocket_server.py.
ENABLE_LEGACY_WEBSOCKET=0

# SQLite historical-events store (file paths). The defaults resolve inside backend/.
# HISTORICAL_EVENTS_DB=data/historical_events.db
# HISTORICAL_EVENTS_SEED=data/historical_events.json

# Regime Intelligence (FRED)
# Get a key: https://fred.stlouisfed.org/docs/api/api_key.html
# Leave empty to use FRED's public CSV fallback.
FRED_API_KEY=
