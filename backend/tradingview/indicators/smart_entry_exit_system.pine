// Version: 2.0.0 - Professional Risk Management
// Combines: Crash Risk + Regime + Gann + Astro-Momentum

//@version=5
strategy("Smart Entry/Exit Pro", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=1000, pyramiding=3)

// ============================================
// STRATEGY CONFIGURATION
// ============================================

// Entry Filters
enable_crash_filter = input.bool(true, "Enable Crash Risk Filter", group="Entry Filters")
max_crash_risk = input.float(30, "Max Crash Risk %", minval=0, maxval=100, group="Entry Filters")

enable_regime_filter = input.bool(true, "Enable Regime Filter", group="Entry Filters")
require_bull_regime = input.bool(true, "Require Bull Regime", group="Entry Filters")

enable_gann_filter = input.bool(true, "Enable Gann Filter", group="Entry Filters")
require_above_1x1 = input.bool(true, "Price Above Gann 1x1", group="Entry Filters")

enable_astro_filter = input.bool(true, "Enable Astro Filter", group="Entry Filters")
min_astro_momentum = input.float(0, "Min Astro-Momentum", minval=-100, maxval=100, group="Entry Filters")

// Risk Management (Advanced)
risk_per_trade_pct = input.float(2.0, "Risk Per Trade %", minval=0.5, maxval=10, step=0.5, group="Risk Management")
use_vol_based_sizing = input.bool(true, "Volatility-Based Position Sizing", group="Risk Management")
atr_multiplier = input.float(2.0, "ATR Multiplier for Stop", minval=1, maxval=5, step=0.5, group="Risk Management")

//Trailing Stop Options
trail_type = input.string("ATR", "Trailing Stop Type", options=["ATR", "PSAR", "Percent"], group="Trailing Stop")
atr_trail_mult = input.float(1.5, "ATR Trail Multiplier", minval=0.5, maxval=5, step=0.1, group="Trailing Stop")
trail_pct = input.float(3, "Trail %", minval=1, maxval=10, group="Trailing Stop")

// Take Profit
use_take_profit = input.bool(true, "Use Take Profit", group="Take Profit")
take_profit_rr = input.float(2.0, "Risk/Reward Ratio", minval=1, maxval=5, step=0.5, group="Take Profit")

// Pyramiding
allow_pyramiding = input.bool(true, "Allow Pyramiding", group="Pyramiding")
pyramid_profit_pct = input.float(3, "Profit % for Pyramid", minval=1, maxval=10, group="Pyramiding")
max_pyramids = input.int(2, "Max Pyramid Adds", minval=1, maxval=3, group="Pyramiding")

// Time Exit
use_time_exit = input.bool(true, "Use Time-Based Exit", group="Time Management")
max_bars_in_trade = input.int(50, "Max Bars in Trade", minval=10, maxval=200, group="Time Management")

// Session Filter
use_session_filter = input.bool(false, "Enable Session Filter", group="Session Filter")
session_start = input.int(14, "Session Start Hour (GMT)", minval=0, maxval=23, group="Session Filter")
session_end = input.int(21, "Session End Hour (GMT)", minval=0, maxval=23, group="Session Filter")

// Display
show_entry_labels = input.bool(true, "Show Entry Labels", group="Display")
show_exit_labels = input.bool(true, "Show Exit Labels", group="Display")
show_stats_table = input.bool(true, "Show Performance Stats", group="Display")
show_atr = input.bool(true, "Show ATR Bands", group="Display")

// ============================================
// ATR & VOLATILITY
// ============================================

atr = ta.atr(14)
atr_slow = ta.atr(50)
vol_ratio = atr / atr_slow  // Volatility expansion/contraction

// ============================================
// COMPONENT 1: CRASH RISK (0-100%)
// ============================================

volatility_20 = ta.stdev(close, 20) / close * 100
volatility_normalized = math.min(volatility_20 / 5, 1) * 40

rsi = ta.rsi(close, 14)
momentum_risk = rsi < 30 ? (30 - rsi) / 30 * 30 : rsi > 70 ? (rsi - 70) / 30 * 30 : 0

ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
ma200 = ta.sma(close, 200)
death_cross = close < ma20 and ma20 < ma50 and ma50 < ma200
death_cross_risk = death_cross ? 20 : 0

volume_ma = ta.sma(volume, 20)
volume_spike = volume > volume_ma * 2
volume_risk = volume_spike and close < close[1] ? 10 : 0

crash_risk = math.min(volatility_normalized + momentum_risk + death_cross_risk + volume_risk, 100)

// ============================================
// COMPONENT 2: REGIME (0=Consol, 1=Bull, 2=Bear)
// ============================================

price_vs_ma20 = (close - ma20) / ma20 * 100
price_vs_ma50 = (close - ma50) / ma50 * 100

ma20_above_ma50 = ma20 > ma50
ma50_above_ma200 = ma50 > ma200
golden_cross = ma20_above_ma50 and ma50_above_ma200

bull_score = (golden_cross ? 40 : 0) + (price_vs_ma20 > 2 ? 30 : 0) + (price_vs_ma50 > 5 ? 20 : 0)
bear_score = (death_cross ? 40 : 0) + (price_vs_ma20 < -2 ? 30 : 0) + (price_vs_ma50 < -5 ? 20 : 0)

regime_raw = bull_score > 60 ? 1 : bear_score > 60 ? 2 : 0
regime = int(ta.mode(regime_raw, 20))

// ============================================
// COMPONENT 3: GANN 1x1 ANGLE
// ============================================

swing_lookback = 10
is_swing_low = ta.lowestbars(low, swing_lookback) == 0

var float gann_1x1_level = na
var int gann_bars_since = 0

if is_swing_low
    gann_1x1_level := low
    gann_bars_since := 0
else if not na(gann_1x1_level)
    gann_bars_since += 1
    avg_range = ta.sma(high - low, 20)
    gann_1x1_level += avg_range

price_above_gann = not na(gann_1x1_level) and close > gann_1x1_level

// ============================================
// COMPONENT 4: ASTRO-MOMENTUM (-100 to +100)
// ============================================

lunar_cycle = (dayofmonth % 30) / 29.53
lunar_phase = math.sin(lunar_cycle * 2 * math.pi)
lunar_bullish_bias = lunar_phase > 0 ? math.abs(lunar_phase) * 0.7 : -math.abs(lunar_phase) * 0.3

mercury_retro = ((dayofyear % 88) / 88 > 0.6 and (dayofyear % 88) / 88 < 0.8) ? 1 : 0
venus_retro = ((dayofyear % 548) / 548 > 0.45 and (dayofyear % 548) / 548 < 0.55) ? 1 : 0
active_retrogrades = mercury_retro + venus_retro

lunar_volatility_index = 1.0 - math.abs(lunar_phase - 0.5) * 2

astro_momentum_raw = (lunar_bullish_bias * 40) - (active_retrogrades * 10) + (lunar_volatility_index * 20)
astro_momentum = ta.ema(astro_momentum_raw, 9)

// ============================================
// SESSION FILTER
// ============================================

is_in_session = true
if use_session_filter
    current_hour = hour
    is_in_session := current_hour >= session_start and current_hour < session_end

// ============================================
// ENTRY LOGIC (All Filters Must Pass)
// ============================================

crash_filter_pass = not enable_crash_filter or crash_risk < max_crash_risk
regime_filter_pass = not enable_regime_filter or (require_bull_regime and regime == 1)
gann_filter_pass = not enable_gann_filter or (require_above_1x1 and price_above_gann)
astro_filter_pass = not enable_astro_filter or astro_momentum > min_astro_momentum
session_filter_pass = not use_session_filter or is_in_session

all_filters_pass = crash_filter_pass and regime_filter_pass and gann_filter_pass and astro_filter_pass and session_filter_pass

// Entry trigger: Price bounce or RSI oversold
price_bounce = ta.crossover(close, ma20) or ta.crossover(rsi, 30)

long_entry = all_filters_pass and price_bounce and strategy.position_size == 0

// ============================================
// POSITION SIZING (Volatility-Based)
// ============================================

var float position_size_usd = 0.0

if use_vol_based_sizing
    // Calculate position size based on ATR
    stop_distance = atr * atr_multiplier
    risk_usd = strategy.equity * (risk_per_trade_pct / 100)
    shares = math.floor(risk_usd / stop_distance)
    position_size_usd := shares * close
else
    // Fixed percentage of equity
    position_size_usd := strategy.equity * (risk_per_trade_pct / 100)

// ============================================
// STRATEGY EXECUTION
// ============================================

// Entry
if long_entry
    stop_price = close - (atr * atr_multiplier)
    take_price = use_take_profit ? close + (atr * atr_multiplier * take_profit_rr) : na
    
    strategy.entry("Long", strategy.long, qty=position_size_usd / close)

// Pyramiding (add to winners)
var int pyramid_count = 0
if strategy.position_size > 0
    profit_pct = (close - strategy.position_avg_price) / strategy.position_avg_price * 100
    can_pyramid = allow_pyramiding and pyramid_count < max_pyramids and profit_pct > pyramid_profit_pct
    
    if can_pyramid and all_filters_pass
        strategy.entry("Pyramid" + str.tostring(pyramid_count), strategy.long, qty=(position_size_usd / close) * 0.5)
        pyramid_count += 1

if strategy.position_size == 0
    pyramid_count := 0

// ============================================
// TRAILING STOP
// ============================================

var float trail_stop = na

if strategy.position_size > 0
    if trail_type == "ATR"
        trail_stop := close - (atr * atr_trail_mult)
    else if trail_type == "PSAR"
        trail_stop := ta.sar(0.02, 0.02, 0.2)
    else
        trail_stop := close * (1 - trail_pct / 100)
    
    // Keep highest trail stop (don't lower it)
    trail_stop := math.max(nz(trail_stop[1], trail_stop), trail_stop)
    
    strategy.exit("Trail Stop", from_entry="Long", stop=trail_stop)
    
    // Exit all pyramid entries with same stop
    if pyramid_count > 0
        for i = 0 to pyramid_count - 1
            strategy.exit("Trail " + str.tostring(i), from_entry="Pyramid" + str.tostring(i), stop=trail_stop)
else
    trail_stop := na

// ============================================
// TIME-BASED EXIT
// ============================================

var int entry_bar = 0
if strategy.position_size > 0 and strategy.position_size[1] == 0
    entry_bar := bar_index

bars_in_trade = strategy.position_size > 0 ? bar_index - entry_bar : 0

if use_time_exit and bars_in_trade > max_bars_in_trade and strategy.position_size > 0
    if close < strategy.position_avg_price
        strategy.close_all(comment="Time Exit")

// ============================================
// CRASH/REGIME EXIT
// ============================================

crash_exit = crash_risk > 50
regime_exit = regime == 2
astro_exit = astro_momentum < 0

if (crash_exit or regime_exit or astro_exit) and strategy.position_size > 0
    strategy.close_all(comment="Signal Exit")

// ============================================
// VISUALIZATION
// ============================================

// Plot components
plot(ma20, "MA20", color.orange, 2)
plot(ma50, "MA50", color.blue, 2)
plot(ma200, "MA200", color.purple, 3)
plot(gann_1x1_level, "Gann 1x1", color.new(color.purple, 30), 2, plot.style_linebr)

// ATR Bands
if show_atr
    plot(close + atr * atr_multiplier, "Upper ATR", color.new(color.red, 70), 1)
    plot(close - atr * atr_multiplier, "Lower ATR", color.new(color.green, 70), 1)

// Trail stop
plot(strategy.position_size > 0 ? trail_stop : na, "Trail Stop", color.new(color.red, 0), 2, plot.style_circles)

// Entry/Exit labels
plotshape(show_entry_labels and long_entry, "Entry", shape.labelup, location.belowbar, 
    color.new(color.green, 0), size=size.normal, text="BUY", textcolor=color.white)

// Background coloring
bgcolor(regime == 1 ? color.new(color.green, 97) :
        regime == 2 ? color.new(color.red, 97) : color.new(color.gray, 98))

// ============================================
// PERFORMANCE STATS TABLE
// ============================================

var table stats_table = table.new(position.bottom_right, 2, 10, 
    bgcolor=color.new(color.black, 85), 
    border_width=2)

if show_stats_table and barstate.islast
    // Header
    table.cell(stats_table, 0, 0, "Strategy Stats", 
        text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 70))
    table.cell(stats_table, 1, 0, "Smart Pro", 
        text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 70))
    
    // Live Stats
    table.cell(stats_table, 0, 1, "Position", text_color=color.gray, text_size=size.tiny)
    pos_text = strategy.position_size > 0 ? "LONG" : "FLAT"
    table.cell(stats_table, 1, 1, pos_text, 
        text_color=strategy.position_size > 0 ? color.lime : color.gray, text_size=size.tiny)
    
    // P&L
    pnl_pct = strategy.position_size > 0 ? (close - strategy.position_avg_price) / strategy.position_avg_price * 100 : 0
    table.cell(stats_table, 0, 2, "Open P&L", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 2, str.tostring(pnl_pct, "#.##") + "%", 
        text_color=pnl_pct > 0 ? color.lime : color.red, text_size=size.tiny)
    
    // Backtest Performance
    win_rate = strategy.wintrades > 0 ? (strategy.wintrades / (strategy.wintrades + strategy.losstrades) * 100) : 0
    table.cell(stats_table, 0, 3, "Win Rate", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 3, str.tostring(win_rate, "#.#") + "%", 
        text_color=win_rate > 50 ? color.lime : color.red, text_size=size.tiny)
    
    profit_factor = strategy.grossprofit > 0 ? strategy.grossprofit / math.max(strategy.grossloss, 1) : 0
    table.cell(stats_table, 0, 4, "Profit Factor", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 4, str.tostring(profit_factor, "#.##"), 
        text_color=profit_factor > 1.5 ? color.lime : color.yellow, text_size=size.tiny)
    
    // Risk Metrics
    table.cell(stats_table, 0, 5, "ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 5, str.tostring(atr, "#.##"), 
        text_color=color.white, text_size=size.tiny)
    
    table.cell(stats_table, 0, 6, "Vol Ratio", text_color=color.gray, text_size=size.tiny)
    vol_color = vol_ratio > 1.5 ? color.red : vol_ratio < 0.7 ? color.green : color.yellow
    table.cell(stats_table, 1, 6, str.tostring(vol_ratio, "#.##"), 
        text_color=vol_color, text_size=size.tiny)
    
    // Filter Status
    table.cell(stats_table, 0, 7, "All Filters", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 7, all_filters_pass ? "PASS ✓" : "FAIL ✗", 
        text_color=all_filters_pass ? color.lime : color.red, text_size=size.tiny)
    
    // Pyramids
    table.cell(stats_table, 0, 8, "Pyramids", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 8, str.tostring(pyramid_count) + "/" + str.tostring(max_pyramids), 
        text_color=color.white, text_size=size.tiny)
    
    // Model Accuracy
    table.cell(stats_table, 0, 9, "Model Acc", text_color=color.gray, text_size=size.tiny)
    table.cell(stats_table, 1, 9, "97.67%", text_color=color.lime, text_size=size.tiny)

// ============================================
// PROFESSIONAL FEATURES
// ============================================

// - Volatility-based position sizing (ATR)
// - 3 types of trailing stops (ATR, PSAR, Percent)
// - Pyramiding with profit-based adds
// - Time-based exits prevent bag holding
// - Session filters for optimal liquidity
// - Real-time P&L tracking
// - Performance analytics (win rate, profit factor)
// - Risk metrics (ATR, volatility ratio)

// USE CASES:
// 1. Scalping: Short timeframes + tight ATR trail
// 2. Swing Trading: Daily + PSAR trail + pyramiding
// 3. Position Trading: Weekly + loose trail + low risk%

// OPTIMIZATION TIPS:
// - Backtest 2+ years of data
// - Adjust ATR multiplier for asset volatility
// - Test different R:R ratios (1.5, 2, 2.5, 3)
// - Optimize session hours for your market
// - Start with 1% risk, increase if profitable

