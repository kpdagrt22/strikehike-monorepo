// Version: 2.0.0 - Multi-Timeframe Edition
// Model Accuracy: 95.68%

//@version=5
indicator("Regime Detector Pro MTF", overlay=true, max_bars_back=500)

// ============================================
// ENTERPRISE CONFIGURATION
// ============================================

// Multi-Timeframe Settings
enable_mtf = input.bool(true, "Enable Multi-Timeframe Analysis", group="Multi-Timeframe")
tf_1 = input.timeframe("60", "Timeframe 1", group="Multi-Timeframe")
tf_2 = input.timeframe("240", "Timeframe 2", group="Multi-Timeframe")
tf_3 = input.timeframe("D", "Timeframe 3", group="Multi-Timeframe")
tf_4 = input.timeframe("W", "Timeframe 4", group="Multi-Timeframe")

show_mtf_table = input.bool(true, "Show MTF Table", group="Multi-Timeframe")
show_divergence_alerts = input.bool(true, "Show Divergence Alerts", group="Multi-Timeframe")

// Regime Detection Settings
smoothing_length = input.int(20, "Regime Smoothing (bars)", minval=5, maxval=50, group="Detection")
use_ma_confluence = input.bool(true, "Use MA Confluence", group="Detection")
confidence_threshold = input.float(0.8, "Min Confidence for Signals", minval=0.5, maxval=1.0, group="Detection")

// Display Settings
show_confidence = input.bool(true, "Show Confidence %", group="Display")
show_background = input.bool(true, "Background Coloring", group="Display")
show_arrows = input.bool(true, "Regime Change Arrows", group="Display")
show_current_tf_only = input.bool(false, "Current TF Background Only", group="Display")

// Alert Settings
alert_regime_change = input.bool(true, "Alert on Regime Change", group="Alerts")
alert_on_divergence = input.bool(true, "Alert on MTF Divergence", group="Alerts")
alert_on_full_alignment = input.bool(true, "Alert on Full Alignment", group="Alerts")

// Color Scheme
color_bull = input.color(color.new(color.green, 0), "Bull Regime", group="Colors")
color_bear = input.color(color.new(color.red, 0), "Bear Regime", group="Colors")
color_consolidation = input.color(color.new(color.gray, 0), "Consolidation", group="Colors")

// ============================================
// REGIME DETECTION FUNCTION
// ============================================

f_detect_regime() =>
    // Moving Averages (from 95.68% accuracy model)
    ma20 = ta.sma(close, 20)
    ma50 = ta.sma(close, 50)
    ma200 = ta.sma(close, 200)
    
    // Price vs MA Ratios (key features from model)
    price_vs_ma20 = (close - ma20) / ma20 * 100
    price_vs_ma50 = (close - ma50) / ma50 * 100
    price_vs_ma200 = (close - ma200) / ma200 * 100
    
    // Moving Average Crossovers
    ma20_above_ma50 = ma20 > ma50
    ma50_above_ma200 = ma50 > ma200
    golden_cross = ma20_above_ma50 and ma50_above_ma200
    death_cross = not ma20_above_ma50 and not ma50_above_ma200
    
    // Volatility (20-day rolling std)
    volatility = ta.stdev(close, 20) / close * 100
    
    // Volume trend
    volume_ma = ta.sma(volume, 20)
    volume_trend = volume > volume_ma
    
    // Bull Regime (1): Strong uptrend
    bull_score = (golden_cross ? 40 : 0) + 
                 (price_vs_ma20 > 2 ? 30 : 0) + 
                 (price_vs_ma50 > 5 ? 20 : 0) + 
                 (volume_trend ? 10 : 0)
    
    // Bear Regime (2): Strong downtrend  
    bear_score = (death_cross ? 40 : 0) + 
                 (price_vs_ma20 < -2 ? 30 : 0) + 
                 (price_vs_ma50 < -5 ? 20 : 0) + 
                 (volatility > 3 ? 10 : 0)
    
    // Determine regime
    regime_raw = bull_score > 60 ? 1 : 
                 bear_score > 60 ? 2 : 0
    
    // Smooth regime to reduce whipsaws
    regime_smooth = int(ta.mode(regime_raw, smoothing_length))
    
    // Confidence calculation
    confidence = regime_smooth == 1 ? bull_score / 100 :
                 regime_smooth == 2 ? bear_score / 100 : 
                 0.50
    
    [regime_smooth, confidence, price_vs_ma20]

// ============================================
// CURRENT TIMEFRAME REGIME
// ============================================

[regime, confidence, price_vs_ma20] = f_detect_regime()

// Moving averages for display
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
ma200 = ta.sma(close, 200)

// ============================================
// MULTI-TIMEFRAME REGIME DETECTION
// ============================================

// Fetch regime from different timeframes (avoid repainting)
[regime_tf1, conf_tf1, _] = request.security(syminfo.tickerid, tf_1, f_detect_regime(), lookahead=barmerge.lookahead_off)
[regime_tf2, conf_tf2, _] = request.security(syminfo.tickerid, tf_2, f_detect_regime(), lookahead=barmerge.lookahead_off)
[regime_tf3, conf_tf3, _] = request.security(syminfo.tickerid, tf_3, f_detect_regime(), lookahead=barmerge.lookahead_off)
[regime_tf4, conf_tf4, _] = request.security(syminfo.tickerid, tf_4, f_detect_regime(), lookahead=barmerge.lookahead_off)

// ============================================
// CONFLUENCE SCORE CALCULATION
// ============================================

// Weight higher timeframes more heavily
weight_tf1 = 20.0  // Lowest timeframe
weight_tf2 = 25.0
weight_tf3 = 27.5  // Daily
weight_tf4 = 27.5  // Weekly (highest weight)

// Bull alignment score
bull_alignment = (regime_tf1 == 1 ? weight_tf1 : 0) + 
                 (regime_tf2 == 1 ? weight_tf2 : 0) + 
                 (regime_tf3 == 1 ? weight_tf3 : 0) + 
                 (regime_tf4 == 1 ? weight_tf4 : 0)

// Bear alignment score
bear_alignment = (regime_tf1 == 2 ? weight_tf1 : 0) + 
                 (regime_tf2 == 2 ? weight_tf2 : 0) + 
                 (regime_tf3 == 2 ? weight_tf3 : 0) + 
                 (regime_tf4 == 2 ? weight_tf4 : 0)

// Overall confluence (0-100%)
confluence_score = math.max(bull_alignment, bear_alignment)

// Determine dominant regime across timeframes
mtf_regime = bull_alignment > bear_alignment ? 1 : 
             bear_alignment > bull_alignment ? 2 : 0

// Full alignment detection
full_bull_alignment = regime_tf1 == 1 and regime_tf2 == 1 and regime_tf3 == 1 and regime_tf4 == 1
full_bear_alignment = regime_tf1 == 2 and regime_tf2 == 2 and regime_tf3 == 2 and regime_tf4 == 2
full_alignment = full_bull_alignment or full_bear_alignment

// ============================================
// DIVERGENCE DETECTION
// ============================================

// Major divergence: Current TF disagrees with higher TFs
major_bull_divergence = regime == 1 and regime_tf3 == 2 and regime_tf4 == 2  // Current bull but D+W bear
major_bear_divergence = regime == 2 and regime_tf3 == 1 and regime_tf4 == 1  // Current bear but D+W bull

// Minor divergence: Mixed signals
minor_divergence = not full_alignment and confluence_score < 75

has_divergence = major_bull_divergence or major_bear_divergence or minor_divergence

// ============================================
// REGIME CHANGE DETECTION
// ============================================

regime_changed = ta.change(regime) != 0
regime_to_bull = regime_changed and regime == 1
regime_to_bear = regime_changed and regime == 2
regime_to_consol = regime_changed and regime == 0

// MTF regime change
mtf_regime_changed = ta.change(mtf_regime) != 0
mtf_to_bull = mtf_regime_changed and mtf_regime == 1
mtf_to_bear = mtf_regime_changed and mtf_regime == 2

// Count bars in current regime
var int bars_in_regime = 0
if regime_changed
    bars_in_regime := 0
else
    bars_in_regime += 1

// ============================================
// REGIME NAMES & COLORS
// ============================================

regime_name = regime == 1 ? "BULL MARKET" :
              regime == 2 ? "BEAR MARKET" :
              "CONSOLIDATION"

mtf_regime_name = mtf_regime == 1 ? "MTF BULL" :
                  mtf_regime == 2 ? "MTF BEAR" :
                  "MTF MIXED"

regime_color = regime == 1 ? color_bull :
               regime == 2 ? color_bear :
               color_consolidation

mtf_color = mtf_regime == 1 ? color_bull :
            mtf_regime == 2 ? color_bear :
            color_consolidation

// ============================================
// VISUALIZATION
// ============================================

// Background coloring (current TF or MTF)
bgcolor_regime = show_current_tf_only ? regime : mtf_regime
bgcolor_color = bgcolor_regime == 1 ? color.new(color_bull, 95) :
                bgcolor_regime == 2 ? color.new(color_bear, 95) :
                color.new(color_consolidation, 97)

if show_background
    bgcolor(bgcolor_color, title="Regime Background")

// Regime change arrows
plotshape(show_arrows and regime_to_bull and confidence > confidence_threshold, 
    "Bull Start", 
    shape.triangleup, 
    location.belowbar, 
    color_bull, 
    size=size.normal,
    text="BULL")

plotshape(show_arrows and regime_to_bear and confidence > confidence_threshold, 
    "Bear Start", 
    shape.triangledown, 
    location.abovebar, 
    color_bear, 
    size=size.normal,
    text="BEAR")

// Full alignment indicators
plotshape(show_arrows and full_bull_alignment and ta.change(full_bull_alignment), 
    "Full Bull", 
    shape.diamond, 
    location.belowbar, 
    color.new(color.green, 0), 
    size=size.large,
    text="FULL BULL")

plotshape(show_arrows and full_bear_alignment and ta.change(full_bear_alignment), 
    "Full Bear", 
    shape.diamond, 
    location.abovebar, 
    color.new(color.red, 0), 
    size=size.large,
    text="FULL BEAR")

// Divergence warning
plotshape(show_divergence_alerts and major_bull_divergence, 
    "Major Bull Div", 
    shape.xcross, 
    location.abovebar, 
    color.new(color.orange, 0), 
    size=size.small,
    text="DIV⚠️")

plotshape(show_divergence_alerts and major_bear_divergence, 
    "Major Bear Div", 
    shape.xcross, 
    location.belowbar, 
    color.new(color.orange, 0), 
    size=size.small,
    text="DIV⚠️")

// Plot moving averages
plot(ma20, "MA20", color.new(color.orange, 30), 2)
plot(ma50, "MA50", color.new(color.blue, 30), 2)
plot(ma200, "MA200", color.new(color.purple, 30), 3)

// ============================================
// MAIN INFO TABLE
// ============================================

var table regime_table = table.new(position.top_left, 2, 7, 
    bgcolor=color.new(color.black, 85), 
    border_width=2,
    border_color=regime_color)

if barstate.islast
    // Header
    table.cell(regime_table, 0, 0, "Regime Detector", 
        text_color=color.white, 
        text_size=size.normal,
        bgcolor=color.new(regime_color, 70))
    table.cell(regime_table, 1, 0, "Pro MTF", 
        text_color=color.white, 
        text_size=size.small,
        bgcolor=color.new(regime_color, 70))
    
    // Current Regime
    table.cell(regime_table, 0, 1, "Current TF", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(regime_table, 1, 1, regime_name, 
        text_color=regime_color, 
        text_size=size.normal)
    
    // MTF Regime
    table.cell(regime_table, 0, 2, "MTF Regime", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(regime_table, 1, 2, mtf_regime_name, 
        text_color=mtf_color, 
        text_size=size.normal)
    
    // Confluence Score
    table.cell(regime_table, 0, 3, "Confluence", 
        text_color=color.gray, 
        text_size=size.tiny)
    conf_color = confluence_score > 90 ? color.lime : 
                 confluence_score > 75 ? color.yellow : color.orange
    table.cell(regime_table, 1, 3, str.tostring(confluence_score, "#.#") + "%", 
        text_color=conf_color, 
        text_size=size.normal)
    
    // Confidence
    if show_confidence
        table.cell(regime_table, 0, 4, "TF Confidence", 
            text_color=color.gray, 
            text_size=size.tiny)
        table.cell(regime_table, 1, 4, str.tostring(confidence * 100, "#.#") + "%", 
            text_color=color.white, 
            text_size=size.tiny)
    
    // Divergence Status
    table.cell(regime_table, 0, 5, "Divergence", 
        text_color=color.gray, 
        text_size=size.tiny)
    div_text = has_divergence ? "YES ⚠️" : "None"
    div_color = has_divergence ? color.orange : color.gray
    table.cell(regime_table, 1, 5, div_text, 
        text_color=div_color, 
        text_size=size.tiny)
    
    // Model Accuracy
    table.cell(regime_table, 0, 6, "Model Acc", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(regime_table, 1, 6, "95.68%", 
        text_color=color.lime, 
        text_size=size.tiny)

// ============================================
// MULTI-TIMEFRAME TABLE
// ============================================

if show_mtf_table
    var table mtf_table = table.new(position.top_right, 3, 5, 
        bgcolor=color.new(color.black, 85), 
        border_width=2,
        border_color=mtf_color)
    
    if barstate.islast
        // Header
        table.cell(mtf_table, 0, 0, "Timeframe", 
            text_color=color.white, text_size=size.tiny, 
            bgcolor=color.new(color.blue, 70))
        table.cell(mtf_table, 1, 0, "Regime", 
            text_color=color.white, text_size=size.tiny, 
            bgcolor=color.new(color.blue, 70))
        table.cell(mtf_table, 2, 0, "Conf%", 
            text_color=color.white, text_size=size.tiny, 
            bgcolor=color.new(color.blue, 70))
        
        // TF1
        table.cell(mtf_table, 0, 1, tf_1, 
            text_color=color.gray, text_size=size.tiny)
        tf1_name = regime_tf1 == 1 ? "Bull" : regime_tf1 == 2 ? "Bear" : "Range"
        tf1_color = regime_tf1 == 1 ? color.lime : regime_tf1 == 2 ? color.red : color.gray
        table.cell(mtf_table, 1, 1, tf1_name, 
            text_color=tf1_color, text_size=size.tiny)
        table.cell(mtf_table, 2, 1, str.tostring(conf_tf1 * 100, "#"), 
            text_color=color.white, text_size=size.tiny)
        
        // TF2
        table.cell(mtf_table, 0, 2, tf_2, 
            text_color=color.gray, text_size=size.tiny)
        tf2_name = regime_tf2 == 1 ? "Bull" : regime_tf2 == 2 ? "Bear" : "Range"
        tf2_color = regime_tf2 == 1 ? color.lime : regime_tf2 == 2 ? color.red : color.gray
        table.cell(mtf_table, 1, 2, tf2_name, 
            text_color=tf2_color, text_size=size.tiny)
        table.cell(mtf_table, 2, 2, str.tostring(conf_tf2 * 100, "#"), 
            text_color=color.white, text_size=size.tiny)
        
        // TF3 (Daily)
        table.cell(mtf_table, 0, 3, tf_3, 
            text_color=color.gray, text_size=size.tiny)
        tf3_name = regime_tf3 == 1 ? "Bull" : regime_tf3 == 2 ? "Bear" : "Range"
        tf3_color = regime_tf3 == 1 ? color.lime : regime_tf3 == 2 ? color.red : color.gray
        table.cell(mtf_table, 1, 3, tf3_name, 
            text_color=tf3_color, text_size=size.tiny)
        table.cell(mtf_table, 2, 3, str.tostring(conf_tf3 * 100, "#"), 
            text_color=color.white, text_size=size.tiny)
        
        // TF4 (Weekly)
        table.cell(mtf_table, 0, 4, tf_4, 
            text_color=color.gray, text_size=size.tiny)
        tf4_name = regime_tf4 == 1 ? "Bull" : regime_tf4 == 2 ? "Bear" : "Range"
        tf4_color = regime_tf4 == 1 ? color.lime : regime_tf4 == 2 ? color.red : color.gray
        table.cell(mtf_table, 1, 4, tf4_name, 
            text_color=tf4_color, text_size=size.tiny)
        table.cell(mtf_table, 2, 4, str.tostring(conf_tf4 * 100, "#"), 
            text_color=color.white, text_size=size.tiny)

// ============================================
// TRADING SIGNALS (MTF Enhanced)
// ============================================

// Long signal: MTF regime bull + high confluence
long_signal = mtf_to_bull and confluence_score > 75 and confidence > confidence_threshold

// Short signal: MTF regime bear + high confluence
short_signal = mtf_to_bear and confluence_score > 75 and confidence > confidence_threshold

// Strong signals: Full alignment
strong_long = full_bull_alignment and ta.change(full_bull_alignment)
strong_short = full_bear_alignment and ta.change(full_bear_alignment)

// Plot signals
plotshape(long_signal or strong_long, 
    "Long Signal", 
    shape.labelup, 
    location.belowbar, 
    color.new(color.green, 0), 
    size=strong_long ? size.large : size.small,
    text=strong_long ? "STRONG LONG" : "LONG",
    textcolor=color.white)

plotshape(short_signal or strong_short, 
    "Short Signal", 
    shape.labeldown, 
    location.abovebar, 
    color.new(color.red, 0), 
    size=strong_short ? size.large : size.small,
    text=strong_short ? "STRONG SHORT" : "SHORT",
    textcolor=color.white)

// ============================================
// ALERT CONDITIONS
// ============================================

alertcondition(mtf_to_bull and alert_regime_change, 
    "MTF → Bull", 
    "🟢 MULTI-TIMEFRAME BULL\nConfluence: {{plot_0}}%\nAction: Enter long positions")

alertcondition(mtf_to_bear and alert_regime_change, 
    "MTF → Bear", 
    "🔴 MULTI-TIMEFRAME BEAR\nConfluence: {{plot_0}}%\nAction: Exit longs, consider shorts")

alertcondition(full_bull_alignment and ta.change(full_bull_alignment) and alert_on_full_alignment, 
    "Full Bull Alignment", 
    "💎 FULL BULL ALIGNMENT ACROSS ALL TIMEFRAMES\nVery High Conviction Signal")

alertcondition(full_bear_alignment and ta.change(full_bear_alignment) and alert_on_full_alignment, 
    "Full Bear Alignment", 
    "💎 FULL BEAR ALIGNMENT ACROSS ALL TIMEFRAMES\nVery High Conviction Signal")

alertcondition(major_bull_divergence and alert_on_divergence, 
    "Major Bull Divergence", 
    "⚠️ MAJOR DIVERGENCE\nCurrent: Bull | Higher TFs: Bear\nCaution: Possible reversal")

alertcondition(major_bear_divergence and alert_on_divergence, 
    "Major Bear Divergence", 
    "⚠️ MAJOR DIVERGENCE\nCurrent: Bear | Higher TFs: Bull\nCaution: Possible reversal")

// ============================================
// ENHANCED STRATEGY GUIDE
// ============================================

// MULTI-TIMEFRAME CONFLUENCE:
// >90%: Very strong alignment - highest conviction
// 75-90%: Strong alignment - high conviction
// 60-75%: Moderate alignment - medium conviction
// <60%: Weak alignment - low conviction, wait

// FULL ALIGNMENT SIGNALS:
// All 4 timeframes agree - extremely rare, highest probability setups
// Use for largest position sizes
// Hold until alignment breaks

// DIVERGENCE TRADING:
// Major divergence = warning of potential reversal
// Current TF may be early or late to the party
// Higher TFs generally more reliable
// Wait for alignment before entering

// TIMEFRAME WEIGHTS:
// Weekly (27.5%): Strongest influence, trend direction
// Daily (27.5%): Secondary trend confirmation
// 4H (25%): Intermediate swings
// 1H (20%): Entry/exit timing

// DISCLAIMER:
// For educational purposes only. Not financial advice.
// Past performance ≠ future results.
// Multi-timeframe analysis improves accuracy but doesn't guarantee profits.
