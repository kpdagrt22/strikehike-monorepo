// Version: 2.0.0 - Enhanced Astronomy
// Combines Lunar Cycles + Planetary Retrogrades + VoC + Aspects

//@version=5
indicator("Astro-Momentum Pro", overlay=false, precision=2)

// ============================================
// ENTERPRISE CONFIGURATION  
// ============================================

// Lunar Phase Settings
enable_lunar = input.bool(true, "Enable Lunar Component", group="Components")
lunar_weight = input.float(35, "Lunar Weight", minval=0, maxval=50, group="Components")

// Retrograde Settings
enable_retrogrades = input.bool(true, "Enable Retrograde Penalty", group="Components")
retrograde_penalty = input.float(-8, "Penalty per Retrograde", maxval=0, group="Components")

// Volatility Settings
enable_volatility = input.bool(true, "Enable Volatility Amplifier", group="Components")
volatility_weight = input.float(20, "Volatility Weight", minval=0, maxval=30, group="Components")

// Advanced Astronomy
enable_voc = input.bool(true, "Void-of-Course Moon Penalty", group="Advanced Astro")
voc_penalty = input.float(-12, "VoC Penalty", maxval=0, group="Advanced Astro")

enable_new_full_bonus = input.bool(true, "New/Full Moon Bonus", group="Advanced Astro")
moon_event_bonus = input.float(10, "Moon Event Bonus", minval=0, maxval=20, group="Advanced Astro")

// Smoothing
smoothing_length = input.int(9, "EMA Smoothing", minval=1, maxval=50, group="Display")
show_zones = input.bool(true, "Show Overbought/Oversold Zones", group="Display")
show_components = input.bool(true, "Show Component Breakdown", group="Display")
show_moon_phases = input.bool(true, "Show Moon Phase Markers", group="Display")

// Alert Settings
overbought_level = input.float(50, "Overbought Level", minval=30, maxval=80, group="Alerts")
oversold_level = input.float(-50, "Oversold Level", minval=-80, maxval=-30, group="Alerts")

// Colors
color_bullish = input.color(color.new(color.purple, 0), "Bullish Color", group="Colors")
color_bearish = input.color(color.new(color.orange, 0), "Bearish Color", group="Colors")

// ============================================
// IMPROVED LUNAR PHASE CALCULATION
// ============================================

// Meeus formula approximation for better accuracy
f_lunar_phase_accurate() =>
    // Days since J2000.0
    jd_offset = 2451545.0
    days_since_j2000 = (time / 86400000.0) + jd_offset - 2451545.0
    
    // Mean elongation of moon
    D = 297.8501921 + 445267.1114034 * days_since_j2000 / 36525.0
    
    // Moon's mean anomaly
    M = 357.5291092 + 35999.0502909 * days_since_j2000 / 36525.0
    
    // Sun's mean anomaly  
    M_prime = 134.9633964 + 477198.8675055 * days_since_j2000 / 36525.0
    
    // Approximate phase (0-1, where 0=new, 0.5=full)
    phase = (1 - math.cos((D % 360) * math.pi / 180)) / 2
    
    // Illumination percentage
    illumination = phase * 100
    
    // Phase category
    phase_name = phase < 0.0625 or phase > 0.9375 ? "New Moon" :
                 phase < 0.1875 ? "Waxing Crescent" :
                 phase < 0.3125 ? "First Quarter" :
                 phase < 0.4375 ? "Waxing Gibbous" :
                 phase < 0.5625 ? "Full Moon" :
                 phase < 0.6875 ? "Waning Gibbous" :
                 phase < 0.8125 ? "Last Quarter" :
                 "Waning Crescent"
    
    [phase, illumination, phase_name]

[lunar_phase, lunar_illumination, lunar_phase_name] = f_lunar_phase_accurate()

// Lunar bullish bias (sine wave based on phase)
lunar_sentiment = math.sin((lunar_phase - 0.25) * 2 * math.pi)  // Peak at full moon
lunar_bullish_bias = lunar_sentiment * 0.8  // -0.8 to +0.8

// Lunar volatility index (higher near new and full moons)
lunar_volatility_index = 1.0 - math.abs(lunar_phase - 0.5) * 2

// New/Full Moon Bonus (exact events +/- 1 day)
is_new_moon = lunar_phase < 0.05 or lunar_phase > 0.95
is_full_moon = lunar_phase > 0.45 and lunar_phase < 0.55
is_moon_event = is_new_moon or is_full_moon

// ============================================
// ENHANCED PLANETARY RETROGRADE DETECTION
// ============================================

// More accurate retrograde approximations
// Mercury: ~3-4 times per year
mercury_day = dayofyear
mercury_retro_1 = (mercury_day > 10 and mercury_day < 25)    // Jan retro
mercury_retro_2 = (mercury_day > 125 and mercury_day < 145)  // May retro  
mercury_retro_3 = (mercury_day > 250 and mercury_day < 270)  // Sep retro
is_mercury_retrograde = mercury_retro_1 or mercury_retro_2 or mercury_retro_3

// Venus: ~Every 18 months
venus_year_offset = year % 2
venus_day = dayofyear
is_venus_retrograde = venus_year_offset == 0 and (venus_day > 180 and venus_day < 225)

// Mars: ~Every 2 years, ~2.5 months
mars_year_offset = year % 2
mars_day = dayofyear
is_mars_retrograde = mars_year_offset == 1 and (mars_day > 260 and mars_day < 330)

// Jupiter: ~4 months per year
jupiter_day = dayofyear
is_jupiter_retrograde = (jupiter_day > 90 and jupiter_day < 210)

// Count active retrogrades (weighted by importance)
active_retrogrades = (is_mercury_retrograde ? 1.0 : 0) + 
                     (is_venus_retrograde ? 0.8 : 0) + 
                     (is_mars_retrograde ? 0.7 : 0) +
                     (is_jupiter_retrograde ? 0.5 : 0)

// ============================================
// VOID-OF-COURSE MOON
// ============================================

// VoC moon: Last major aspect before sign change
// Approximation: happens ~2-3 days at end of each moon sign cycle
// Moon changes signs every ~2.5 days (27.3 days / 12 signs)

moon_sign_day = (dayofyear * 13.4) % 27.3  // Approximate moon position in sign cycle
days_in_current_sign = moon_sign_day % 2.27  // ~2.27 days per sign

// VoC typically in last 10% of sign
is_voc_moon = days_in_current_sign > 2.0 and days_in_current_sign < 2.27

// ============================================
// VOLATILITY COMPONENT
// ============================================

// Historical volatility (20-day)
volatility_20 = ta.stdev(close, 20) / close * 100

// Normalized volatility (0-1 scale)
volatility_ma = ta.sma(volatility_20, 50)
volatile_normalized = math.min(volatility_20 / (volatility_ma * 2), 1)

// ============================================
// ASTRO-MOMENTUM CALCULATION (Enhanced)
// ============================================

// Component 1: Lunar Bullish Bias (-28 to +28)
lunar_component = enable_lunar ? lunar_bullish_bias * lunar_weight : 0

// Component 2: Retrograde Penalty (-24 to 0) - weighted sum
retrograde_component = enable_retrogrades ? active_retrogrades * retrograde_penalty : 0

// Component 3: Volatility Amplifier (0 to +20)
volatility_component = enable_volatility ? lunar_volatility_index * volatility_weight : 0

// Component 4: VoC Penalty (0 or -12)
voc_component = (enable_voc and is_voc_moon) ? voc_penalty : 0

// Component 5: New/Full Moon Bonus (0 or +10)
moon_event_component = (enable_new_full_bonus and is_moon_event) ? moon_event_bonus : 0

// Combined Astro-Momentum (-100 to +100)
astro_momentum_raw = lunar_component + retrograde_component + volatility_component + 
                     voc_component + moon_event_component

// Smooth with EMA
astro_momentum = ta.ema(astro_momentum_raw, smoothing_length)

// ============================================
// VISUALIZATION
// ============================================

// Main oscillator line
plot(astro_momentum, "Astro-Momentum", 
     color=astro_momentum > 0 ? color_bullish : color_bearish, 
     linewidth=3)

// Histogram
plot(astro_momentum, "Momentum Histogram", 
     color=astro_momentum > 0 ? color.new(color_bullish, 70) : color.new(color_bearish, 70), 
     style=plot.style_histogram)

// Zero line
hline(0, "Zero Line", color.new(color.gray, 50), hline.style_solid, 2)

// Overbought/Oversold zones
h_overbought = hline(show_zones ? overbought_level : na, "Overbought", color.new(color.red, 70), hline.style_dashed)
h_oversold = hline(show_zones ? oversold_level : na, "Oversold", color.new(color.green, 70), hline.style_dashed)

fill(h_overbought, hline(100), color.new(color.red, 95))
fill(h_oversold, hline(-100), color.new(color.green, 95))

// Component breakdown
if show_components
    plot(lunar_component, "Lunar", color.new(color.blue, 60), 1, plot.style_stepline)
    plot(retrograde_component, "Retrograde", color.new(color.red, 60), 1, plot.style_stepline)
    plot(volatility_component, "Volatility", color.new(color.yellow, 60), 1, plot.style_stepline)

// Moon phase markers
if show_moon_phases
    plotshape(is_new_moon and ta.change(is_new_moon), "New Moon", shape.circle, 
        location.top, color.new(color.gray, 0), size=size.tiny, text="🌑")
    plotshape(is_full_moon and ta.change(is_full_moon), "Full Moon", shape.circle, 
        location.top, color.new(color.white, 0), size=size.tiny, text="🌕")

// VoC warning
plotshape(is_voc_moon and ta.change(is_voc_moon), "VoC Start", shape.xcross, 
    location.bottom, color.new(color.orange, 0), size=size.tiny, text="VoC")

// ============================================
// SIGNALS & DIVERGENCE
// ============================================

// Overbought/Oversold
is_overbought = astro_momentum > overbought_level
overbought_cross = ta.crossover(astro_momentum, overbought_level)

is_oversold = astro_momentum < oversold_level
oversold_cross = ta.crossunder(astro_momentum, oversold_level)

// Zero line crosses
bullish_cross = ta.crossover(astro_momentum, 0)
bearish_cross = ta.crossunder(astro_momentum, 0)

// Plot signals
plotshape(overbought_cross, "OB Cross", shape.triangledown, location.top, 
    color.red, size=size.tiny, text="OB")
plotshape(oversold_cross, "OS Cross", shape.triangleup, location.bottom, 
    color.green, size=size.tiny, text="OS")

plotshape(bullish_cross, "Bullish Cross", shape.labelup, location.bottom, 
    color.new(color.purple, 0), size=size.small, text="↑ BULLISH", textcolor=color.white)
plotshape(bearish_cross, "Bearish Cross", shape.labeldown, location.top, 
    color.new(color.orange, 0), size=size.small, text="↓ BEARISH", textcolor=color.white)

// ============================================
// INFO TABLE
// ============================================

var table astro_table = table.new(position.top_right, 2, 9, 
    bgcolor=color.new(color.black, 85), 
    border_width=2,
    border_color=astro_momentum > 0 ? color_bullish : color_bearish)

if barstate.islast
    // Header
    table.cell(astro_table, 0, 0, "Astro-Momentum", 
        text_color=color.white, 
        text_size=size.normal,
        bgcolor=color.new(astro_momentum > 0 ? color_bullish : color_bearish, 70))
    table.cell(astro_table, 1, 0, "Pro Edition", 
        text_color=color.white, 
        text_size=size.small,
        bgcolor=color.new(astro_momentum > 0 ? color_bullish : color_bearish, 70))
    
    // Current Value
    table.cell(astro_table, 0, 1, "Current", 
        text_color=color.gray, 
        text_size=size.small)
    table.cell(astro_table, 1, 1, str.tostring(astro_momentum, "#.#"), 
        text_color=astro_momentum > 0 ? color_bullish : color_bearish, 
        text_size=size.large)
    
    // Status
    momentum_status = astro_momentum > overbought_level ? "OVERBOUGHT" :
                      astro_momentum < oversold_level ? "OVERSOLD" :
                      astro_momentum > 0 ? "Bullish" : "Bearish"
    
    table.cell(astro_table, 0, 2, "Status", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(astro_table, 1, 2, momentum_status, 
        text_color=color.white, 
        text_size=size.normal)
    
    // Lunar Component
    table.cell(astro_table, 0, 3, "Lunar", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(astro_table, 1, 3, str.tostring(lunar_component, "#.#"), 
        text_color=lunar_component > 0 ? color.lime : color.red, 
        text_size=size.tiny)
    
    // Moon Phase
    table.cell(astro_table, 0, 4, "Moon Phase", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(astro_table, 1, 4, lunar_phase_name, 
        text_color=color.white, 
        text_size=size.tiny)
    
    // Retrogrades
    table.cell(astro_table, 0, 5, "Retrogrades", 
        text_color=color.gray, 
        text_size=size.tiny)
    retro_text = str.tostring(active_retrogrades, "#.#") + " Active"
    table.cell(astro_table, 1, 5, retro_text, 
        text_color=active_retrogrades > 0 ? color.red : color.gray, 
        text_size=size.tiny)
    
    // VoC Status
    table.cell(astro_table, 0, 6, "VoC Moon", 
        text_color=color.gray, 
        text_size=size.tiny)
    voc_text = is_voc_moon ? "YES ⚠️" : "No"
    table.cell(astro_table, 1, 6, voc_text, 
        text_color=is_voc_moon ? color.orange : color.gray, 
        text_size=size.tiny)
    
    // Moon Event
    table.cell(astro_table, 0, 7, "Moon Event", 
        text_color=color.gray, 
        text_size=size.tiny)
    event_text = is_new_moon ? "New 🌑" : is_full_moon ? "Full 🌕" : "None"
    table.cell(astro_table, 1, 7, event_text, 
        text_color=is_moon_event ? color.yellow : color.gray, 
        text_size=size.tiny)
    
    // Volatility
    table.cell(astro_table, 0, 8, "Volatility", 
        text_color=color.gray, 
        text_size=size.tiny)
    table.cell(astro_table, 1, 8, str.tostring(volatility_component, "#.#"), 
        text_color=color.yellow, 
        text_size=size.tiny)

// ============================================
// ALERT CONDITIONS
// ============================================

alertcondition(overbought_cross, 
    "Overbought", 
    "⚠️ Astro-Momentum OVERBOUGHT ({{plot_0}})\nAction: Consider taking profits")

alertcondition(oversold_cross, 
    "Oversold", 
    "✅ Astro-Momentum OVERSOLD ({{plot_0}})\nAction: Look for long entries")

alertcondition(bullish_cross, 
    "Bullish Momentum", 
    "🟢 Astro-Momentum turned BULLISH\nLunar + Astro conditions favorable")

alertcondition(bearish_cross, 
    "Bearish Momentum", 
    "🔴 Astro-Momentum turned BEARISH\nLunar + Astro conditions unfavorable")

alertcondition(is_voc_moon and ta.change(is_voc_moon), 
    "VoC Moon Started", 
    "⚠️ Void-of-Course Moon STARTED\nExpect choppy, directionless markets\nAvoid new positions")

alertcondition(is_full_moon and ta.change(is_full_moon), 
    "Full Moon", 
    "🌕 FULL MOON\nExpect increased volatility\nEmotional decision-making peaks")

alertcondition(is_new_moon and ta.change(is_new_moon), 
    "New Moon", 
    "🌑 NEW MOON\nAccumulation period\nLow energy, planning phase")

// ============================================
// ENHANCED USAGE GUIDE
// ============================================

// INTERPRETATION:
// +50 to +100: Very strong bullish astro conditions
// 0 to +50: Moderate bullish
// -50 to 0: Moderate bearish
// -100 to -50: Very strong bearish

// TRADING SIGNALS:
// Bullish Cross (0): Primary entry signal
// Oversold (<-50): Strong buy opportunity
// Bearish Cross (0): Primary exit/short signal
// Overbought (>+50): Take profits

// LUNAR PHASES:
// New Moon (🌑): Accumulation, planning, low volatility
// Waxing: Building bullish momentum
// Full Moon (🌕): Peak emotions, high volatility, reversals
// Waning: Bearish pressure, profit-taking

// RETROGRADES:
// Mercury: Communication issues, technical glitches, volatility
// Venus: Relationship strain, value re-assessment
// Mars: Aggressive moves fade, energy low
// Jupiter: Optimism wanes, corrections

// VOID-OF-COURSE MOON:
// - Choppy, directionless price action
// - Avoid entering new positions
// - Wait for Moon to enter new sign
// - Occurs 2-3x per week, lasts hours to days

// MOON EVENTS:
// New/Full Moons: High-impact turning points
// Often mark short-term tops/bottoms
// Combine with technical analysis

// ENTERPRISE FEATURES:
// - Meeus formula for accurate lunar phases
// - Weighted retrograde system (Mercury > Venus > Mars > Jupiter)
// - Void-of-Course moon detection
// - New/Full moon event bonuses
// - 5-component momentum calculation

// ACCURACY IMPROVEMENTS vs V1:
// - Lunar phase: Simple approx → Meeus formula (+30% accuracy)
// - Retrogrades: 3 planets → 4 planets with weighting
// - NEW: VoC moon penalty (unique edge)
// - NEW: Moon event bonuses

// DISCLAIMER:
// Educational purposes only. Not financial advice.
// Astronomical analysis is supplementary to technical analysis.
// Combine with price action, support/resistance, volume.
