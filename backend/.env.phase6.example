# StrikeHike ML backend — Phase 6 local environment
# Copy to .env and run uvicorn with --env-file .env.

# Comma-separated browser origins. No spaces. No wildcard when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The Phase 6 endpoints consume the precomputed model-output frame.
# Set to 1 only when you explicitly need the HMM/XGBoost joblib artifacts.
LOAD_ML_MODELS=0

# Legacy simulated Socket.IO feed. Keep off for the production ML API.
ENABLE_LEGACY_WEBSOCKET=0

# SQLite historical-parallels store (paths, not database URLs).
# Defaults are resolved from the repository root.
# HISTORICAL_EVENTS_DB=data/historical_events.db
# HISTORICAL_EVENTS_SEED=data/historical_events.json

# PORT is supplied by Render. Locally, pass --port 8010 to uvicorn.
