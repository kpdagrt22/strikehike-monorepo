def validate_crash_predictor(data: pd.DataFrame) -> pd.DataFrame:
    """Validate XGBoost Crash Predictor"""
    logger.info("\n" + "="*60)
    logger.info("VALIDATING: XGBoost (Crash Prediction)")
    logger.info("="*60)
    
    if 'Crash_Minor' not in data.columns:
        logger.error("Crash_Minor column not found. Run feature engineering first.")
        return pd.DataFrame()
    
    # Prepare features
    exclude_cols = ['Close', 'Open', 'High', 'Low', 'Volume', 'Adj Close', 
                    'Returns', 'Volatility', 'Crash_Minor', 'Crash_Major']
    
    feature_cols = [c for c in data.columns if c not in exclude_cols]
    feature_cols = data[feature_cols].select_dtypes(include=[np.number]).columns.tolist()
    
    validation_data = data[data['Crash_Minor'].notna()].copy()
    
    logger.info(f"Validation dataset: {len(validation_data)} samples")
    logger.info(f"Crash events: {validation_data['Crash_Minor'].sum()} ({validation_data['Crash_Minor'].mean():.2%})")
    

