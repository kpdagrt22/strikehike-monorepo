    """Validate NeuralHMM (Planetary → Regime prediction)"""
    logger.info("\n" + "="*60)
    logger.info("VALIDATING: NeuralHMM (Planetary → Market Regime)")
    logger.info("="*60)
    
    # Prepare data
    exclude_cols = ['Close', 'Open', 'High', 'Low', 'Volume', 'Adj Close', 
                    'Returns', 'Volatility', 'Crash_Minor', 'Crash_Major']
    
