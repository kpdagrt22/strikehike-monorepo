from loguru import logger
import pandas as pd
import numpy as np
import os
from datetime import datetime


def load_data(data_path: str = "data/processed/merged_data.csv") -> pd.DataFrame:
    """Load historical data for validation"""
    logger.info(f"Loading data from {data_path}")
    
    if not os.path.exists(data_path):
        logger.error(f"Data file not found: {data_path}")
        logger.error("Run the training pipeline first: python run_pipeline.py")
        raise FileNotFoundError(data_path)
    
    df = pd.read_csv(data_path, index_col=0, parse_dates=True)
    logger.success(f"Loaded {len(df)} rows from {df.index[0]} to {df.index[-1]}")
    
    return df


