def generate_public_track_record(results: pd.DataFrame):
    """Generate public-facing track record page"""
    logger.info("\n" + "="*60)
    logger.info("GENERATING PUBLIC TRACK RECORD")
    logger.info("="*60)
    
    summary = {
        'validation_date': datetime.now().isoformat(),
        'total_periods': len(results),
        'date_range': f"{results['period_start'].min()} to {results['period_end'].max()}",
        'metrics': {
            'accuracy': {
                'mean': float(results['accuracy'].mean()),
                'median': float(results['accuracy'].median()),
                'std': float(results['accuracy'].std()),
                'min': float(results['accuracy'].min()),
                'max': float(results['accuracy'].max())
            },
            'sharpe_ratio': {
                'mean': float(results['sharpe_ratio'].mean()),
                'median': float(results['sharpe_ratio'].median())
            },
            'win_rate': {
                'mean': float(results['win_rate'].mean())
            }
        },
        'passed_criteria': {
            'accuracy_gt_60': bool(results['accuracy'].mean() > 0.60),
            'sharpe_gt_1_5': bool(results['sharpe_ratio'].mean() > 1.5)
        }
    }
    
    # Save as JSON for website
    import json
    os.makedirs('web/public', exist_ok=True)
    with open('web/public/track_record.json', 'w') as f:
        json.dump(summary, f, indent=2)
    
    logger.success("Track record saved to web/public/track_record.json")
    logger.info(f"Overall Accuracy: {summary['metrics']['accuracy']['mean']:.2%}")
    logger.info(f"Overall Sharpe: {summary['metrics']['sharpe_ratio']['mean']:.2f}")
    
    if all(summary['passed_criteria'].values()):
        logger.success("✅ READY FOR PUBLIC LAUNCH")
    else:
        logger.warning("⚠️  Models need improvement before launch")


def main():
    """Run full validation suite"""
    logger.info("="*60)
    logger.info("ASTRO FINANCE - MODEL VALIDATION")
    logger.info("="*60)
    logger.info("This validates your models meet excellence standards.")
    logger.info("Targets: Accuracy >60%, Sharpe >1.5")
    logger.info("")
    
    try:
        # Load data
        data = load_data()
        
        # Validate NeuralHMM
        neural_results = validate_neural_hmm(data)
        
        # Validate Crash Predictor
        crash_results = validate_crash_predictor(data)
        
        # Generate public track record
        if len(neural_results) > 0:
            generate_public_track_record(neural_results)
        
        logger.success("\n✅ VALIDATION COMPLETE")
        logger.info("Review results in data/validation_results_*.csv")
        logger.info("Public track record: web/public/track_record.json")
        
    except Exception as e:
        logger.error(f"Validation failed: {e}")
        import traceback
        traceback.print_exc()
        return 1
    
    return 0


if __name__ == "__main__":
    exit(main())
