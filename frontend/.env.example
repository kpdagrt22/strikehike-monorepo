# StrikeHike frontend — local environment
# Copy to .env.local. These values are server-side only.

# FastAPI ML service (server-side proxy target; never expose as NEXT_PUBLIC_*).
CHRONO_API_URL=http://127.0.0.1:8010

# Optional telemetry opt-outs.
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

# Google Search Console verification token. Set this at build time, then
# redeploy; the layout emits the verification meta tag only when present.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
